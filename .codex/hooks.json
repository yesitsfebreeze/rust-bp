{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^mcp__",
        "hooks": [
          {
            "type": "command",
            "command": "root=$(git rev-parse --show-toplevel) && if [ -x \"$root/target/release/mcp-usage-hook\" ]; then \"$root/target/release/mcp-usage-hook\"; fi",
            "timeout": 3
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^mcp__",
        "hooks": [
          {
            "type": "command",
            "command": "root=$(git rev-parse --show-toplevel) && if [ -x \"$root/target/release/mcp-usage-hook\" ]; then \"$root/target/release/mcp-usage-hook\"; fi",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
